  },
  {
    "p": 30,
    "s": 3,
    "start": 494.28,
    "end": 496.56,
    "text": "“Anh cần phải làm gì đó đi.”"
  },
  {
    "p": 31,
    "s": 0,
    "start": 496.56,
    "end": 497.92,
    "text": "“Con bé bị bắt nạt vì chuyện gì chứ?”"
  },
  {
    "p": 32,
    "s": 0,
    "start": 497.92,
    "end": 501.08,
    "text": "“Mấy cây kẹo mút."
  },
  {
    "p": 32,
    "s": 1,
    "start": 501.08,
    "end": 502.96,
    "text": "Bọn chúng đang chế nhạo chuyện kẹo mút.”"
  },
  {
    "p": 33,
    "s": 0,
    "start": 502.96,
    "end": 504.32,
    "text": "“Con bé đang tiến bộ rất nhiều!"
  },
  {
    "p": 33,
    "s": 1,
    "start": 504.32,
    "end": 506.08,
    "text": "Con bé vừa bị xe tông đấy!”"
  },
  {
    "p": 34,
    "s": 0,
    "start": 506.08,
    "end": 507.48,
    "text": "Ivy cau mày."
  },
  {
    "p": 34,
    "s": 1,
    "start": 507.48,
    "end": 510.72,
    "text": "“Con ranh Winnie Gleason đó đúng là một "
  },
  {
    "p": 35,
    "s": 0,
    "start": 510.72,
    "end": 512.08,
    "text": "PJ nhún vai."
  },
  {
    "p": 35,
    "s": 1,
    "start": 512.08,
    "end": 515.4,
    "text": "“Chúng ta làm gì được chứ?"
  },
  {
    "p": 35,
    "s": 2,
    "start": 515.4,
    "end": 517.44,
    "text": "Trẻ con vốn tàn nhẫn, xưa nay vẫn thế mà"
  },
  {
    "p": 36,
    "s": 0,
    "start": 517.44,
    "end": 519.64,
    "text": "“Em không biết anh sẽ làm gì,” Ivy nói, "
  },
  {
    "p": 36,
    "s": 1,
    "start": 519.64,
    "end": 522.44,
    "text": "“Nhưng em chắc chắn anh sẽ nghĩ ra cách "
  },
  {
    "p": 37,
    "s": 0,
    "start": 522.44,
    "end": 527.36,
    "text": "PJ sẽ mãi mãi bị vợ trừng phạt vì đã để "
  },
  {
    "p": 37,
    "s": 1,
    "start": 527.36,
    "end": 533.56,
    "text": "Ông bảo mình sẽ cần một ngày để suy nghĩ"
  },
  {
    "p": 37,
    "s": 2,
    "start": 533.56,
    "end": 537.88,
    "text": "“Để anh đi bộ giải tỏa đã,” ông nói với "
  },
  {
    "p": 37,
    "s": 3,
    "start": 537.88,
    "end": 542.0,
    "text": "Ông sẽ dành cả ngày để phát thư, đi bộ v"
  },
  {
    "p": 37,
    "s": 4,
    "start": 542.0,
    "end": 542.92,
    "text": "Thế là ông làm đúng như vậy."
  },
  {
    "p": 37,
    "s": 5,
    "start": 542.92,
    "end": 547.52,
    "text": "Và khi ông về nhà tối hôm đó, ông đã tín"
  },
  {
    "p": 37,
    "s": 6,
    "start": 547.52,
    "end": 553.88,
    "text": "Đầy phấn khích, ông bảo với Ivy: “Chúng "
  },
  {
    "p": 38,
    "s": 0,
    "start": 553.88,
    "end": 555.84,
    "text": "“Em nghĩ trẻ con thấy cây kẹo mút bình t"
  },
  {
    "p": 38,
    "s": 1,
    "start": 555.84,
    "end": 559.08,
    "text": "Ivy nói, lại nổi giận."
  },
  {
    "p": 38,
    "s": 2,
    "start": 559.08,
    "end": 561.04,
    "text": "“Đó là kẹo cơ mà!”"
  },
  {
    "p": 39,
    "s": 0,
    "start": 561.04,
    "end": 562.68,
    "text": "“Nhưng Kate là người duy nhất được phép "
  },
  {
    "p": 39,
    "s": 1,
    "start": 562.68,
    "end": 564.2,
    "text": "Con bé khác biệt."
  },
  {
    "p": 39,
    "s": 2,
    "start": 564.2,
    "end": 566.6,
    "text": "Trẻ con thì ghét sự khác biệt."
  },
  {
    "p": 39,
    "s": 3,
    "start": 566.6,
    "end": 569.88,
    "text": "Bọn chúng coi đó là bất công, hoặc kỳ cụ"
  },
  {
    "p": 40,
    "s": 0,
    "start": 569.88,
    "end": 571.92,
    "text": "“Đó là vì lý do y tế cơ mà!”"
  },
  {
    "p": 41,
    "s": 0,
    "start": 571.92,
    "end": 574.68,
    "text": "“Anh sẽ lo việc này,” PJ nói."
  },
  {
    "p": 41,
    "s": 1,
    "start": 574.68,
    "end": 575.92,
    "text": "“Em đừng lo."
  },
  {
    "p": 41,
    "s": 2,
    "start": 575.92,
    "end": 577.12,
    "text": "Nhưng anh sẽ mất vài ngày."
  },
  {
    "p": 41,
    "s": 3,
    "start": 577.12,
    "end": 582.6,
    "text": "Cho anh vài ngày nhé.”"
  },
  {
    "p": 42,
    "s": 0,
    "start": 582.6,
    "end": 586.52,
    "text": "“Được thôi."
  },
  {
    "p": 42,
    "s": 1,
    "start": 586.52,
    "end": 588.72,
    "text": "Tùy anh xử lý đấy,” Ivy nói."
  },
  {
    "p": 43,
    "s": 0,
    "start": 588.72,
    "end": 591.56,
    "text": "“Anh sẽ cần xin phép các giáo viên,” PJ "
  },
  {
    "p": 44,
    "s": 0,
    "start": 591.56,
    "end": 594.08,
    "text": "Vào một ngày thứ Sáu, Kate và Sophie thứ"
  },
  {
    "p": 44,
    "s": 1,
    "start": 594.08,
    "end": 595.92,
    "text": "Nhưng khi họ bước ra ngoài để đưa Kate r"
  },
  {
    "p": 44,
    "s": 2,
    "start": 595.92,
    "end": 605.08,
    "text": "Đó là ngày đầu tiên của mùa xuân, và nhữ"
  },
  {
    "p": 44,
    "s": 3,
    "start": 605.08,
    "end": 615.48,
    "text": "Có những cây kẹo mút, được bọc trong lớp"
  },
  {
    "p": 44,
    "s": 4,
    "start": 615.48,
    "end": 617.12,
    "text": "Kẹo màu cam, màu vàng, màu xanh lá, màu "
  },
  {
    "p": 44,
    "s": 5,
    "start": 617.12,
    "end": 622.12,
    "text": "Ánh mặt trời phản chiếu lấp lánh trên nh"
  },
  {
    "p": 44,
    "s": 6,
    "start": 622.12,
    "end": 624.28,
    "text": "Chưa ai ở Pondville từng chứng kiến cảnh"
  },
  {
    "p": 45,
    "s": 0,
    "start": 624.28,
    "end": 627.04,
    "text": "Và ở trường vào ngày hôm đó, tất cả lũ t"
  },
  {
    "p": 45,
    "s": 1,
    "start": 627.04,
    "end": 633.4,
    "text": "PJ đã xin phép các giáo viên để cho tất "
  },
  {
    "p": 45,
    "s": 2,
    "start": 633.4,
    "end": 643.32,
    "text": "Ông cũng đã trả cho nhân viên lao công n"
  },
  {
    "p": 46,
    "s": 0,
    "start": 643.32,
    "end": 649.84,
    "text": "Hôm đó tan học về, Kate chạy ù vào nhà v"
  },
  {
    "p": 46,
    "s": 1,
    "start": 649.84,
    "end": 651.04,
    "text": "Ivy đã bấm giờ hẳn hoi."
  },
  {
    "p": 47,
    "s": 0,
    "start": 651.04,
    "end": 658.8,
    "text": "“Chuyện đó đã hàn gắn cuộc hôn nhân của "
  },
  {
    "p": 47,
    "s": 1,
    "start": 658.8,
    "end": 661.08,
    "text": "“Tất nhiên là không phải mãi mãi rồi."
  },
  {
    "p": 47,
    "s": 2,
    "start": 661.08,
    "end": 662.32,
    "text": "Các cháu biết đấy, Ivy đã bỏ ông để theo"
  },
  {
    "p": 48,
    "s": 0,
    "start": 662.32,
    "end": 665.12,
    "text": "Ollie và Luna gật đầu."
  },
  {
    "p": 48,
    "s": 1,
    "start": 665.12,
    "end": 665.88,
    "text": "“Thế ông PJ làm cách nào ạ?”"
  },
  {
    "p": 48,
    "s": 2,
    "start": 665.88,
    "end": 667.48,
    "text": "Luna hỏi."
  },
  {
    "p": 48,
    "s": 3,
    "start": 667.48,
    "end": 670.04,
    "text": "“Sao ông gắn được từng ấy cây kẹo mút lê"
  },
  {
    "p": 49,
    "s": 0,
    "start": 670.04,
    "end": 679.2,
    "text": "PJ mỉm cười nhớ lại."
  },
  {
    "p": 49,
    "s": 1,
    "start": 679.2,
    "end": 683.16,
    "text": "Một kiếp người khác."
  },
  {
    "p": 49,
    "s": 2,
    "start": 683.16,
    "end": 686.72,
    "text": "“Điều tuyệt vời nhất khi làm nhân viên đ"
  },
  {
    "p": 49,
    "s": 3,
    "start": 686.72,
    "end": 694.32,
    "text": "Ông quen chủ tiệm kẹo, và cô ấy gọi điện"
  },
  {
    "p": 49,
    "s": 4,
    "start": 694.32,
    "end": 698.72,
    "text": "Tất cả là nhờ những người bạn tốt ở Pond"
  },
  {
    "p": 49,
    "s": 5,
    "start": 698.72,
    "end": 702.68,
    "text": "Họ đã giúp ông một tay.”"
  },
  {
    "p": 50,
    "s": 0,
    "start": 702.68,
    "end": 704.64,
    "text": "“Và nó không phải ở tất cả mọi cái cây t"
  },
  {
    "p": 50,
    "s": 1,
    "start": 704.64,
    "end": 708.36,
    "text": "“Chỉ là một cái cây bên ngoài nhà của mỗ"
  },
  {
    "p": 51,
    "s": 0,
    "start": 708.36,
    "end": 711.96,
    "text": "“Sophie,” PJ làu bàu, tỏ vẻ khó chịu."
  },
  {
    "p": 51,
    "s": 1,
    "start": 711.96,
    "end": 713.88,
    "text": "“Đừng có phá hỏng câu chuyện chứ.”"
  },
  {
    "p": 52,
    "s": 0,
    "start": 713.88,
    "end": 715.48,
    "text": "“Xin lỗi bố.”"
  },
  {
    "p": 53,
    "s": 0,
    "start": 715.48,
    "end": 716.08,
    "text": "“Ông PJ?”"
  },
  {
    "p": 53,
    "s": 1,
    "start": 716.08,
    "end": 717.44,
    "text": "Ollie hỏi, giọng nghe rất ngái ngủ."
  },
  {
    "p": 54,
    "s": 0,
    "start": 717.44,
    "end": 721.68,
    "text": "“Gì thế, nhóc?”"
  },
  {
    "p": 55,
    "s": 0,
    "start": 721.68,
    "end": 723.08,
    "text": "“Lúc chúng cháu về nhà, ông làm cho chún"
  },
  {
    "p": 56,
    "s": 0,
    "start": 723.08,
    "end": 723.76,
    "text": "“Chắc chắn rồi."
  },
  {
    "p": 56,
    "s": 1,
    "start": 723.76,
    "end": 726.96,
    "text": "Đương nhiên là có rồi.”"
  },
  {
    "p": 57,
    "s": 0,
    "start": 726.96,
    "end": 729.32,
    "text": "“Cháu không về Pondville đâu,” Luna nói."
  },
  {
    "p": 58,
    "s": 0,
    "start": 729.32,
    "end": 731.12,
    "text": "“Bọn cháu biết rồi,” Ollie nói."
  },
  {
    "p": 58,
    "s": 1,
    "start": 731.12,
    "end": 733.56,
    "text": "“Vì chị cứ nói điều đó suốt."
  },
  {
    "p": 58,
    "s": 2,
    "start": 733.56,
    "end": 734.36,
    "text": "Chị không cần phải cứ nhắc hoài đâu.”"
  },
  {
    "p": 59,
    "s": 0,
    "start": 734.36,
    "end": 737.92,
    "text": "“Nào nào, tối nay chúng ta hãy đối xử tử"
  },
  {
    "p": 59,
    "s": 1,
    "start": 737.92,
    "end": 740.56,
    "text": "“Hôm nay là một ngày dài đấy.”"
  },
  {
    "p": 60,
    "s": 0,
    "start": 740.56,
    "end": 751.44,
    "text": "Quả thực là vậy, Sophie nghĩ, nhưng cô v"
  },
  {
    "p": 60,
    "s": 1,
    "start": 751.44,
    "end": 754.48,
    "text": "Rất hợp để kể trước giờ đi ngủ."
  },
  {
    "p": 60,
    "s": 2,
    "start": 754.48,
    "end": 760.68,
    "text": "Khiến cho mọi người đều cảm thấy ấm cúng"
  },
  {
    "p": 60,
    "s": 3,
    "start": 760.68,
    "end": 767.4,
    "text": "Ờ thì, nó sẽ có hậu nếu như bạn dừng câu"
  },
  {
    "p": 60,
    "s": 4,
    "start": 767.4,
    "end": 779.3,
    "text": "Đó là một câu chuyện cổ tích về chú vịt "
  }
]