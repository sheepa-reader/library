[
  {
    "p": 0,
    "s": 0,
    "start": 0.0,
    "end": 9.0,
    "text": "Bọn trẻ đã ngủ say, chú mèo cuộn tròn nh"
  },
  {
    "p": 0,
    "s": 1,
    "start": 9.0,
    "end": 13.36,
    "text": "Họ cứ ngồi đó trong không gian tĩnh lặng"
  },
  {
    "p": 0,
    "s": 2,
    "start": 13.36,
    "end": 18.64,
    "text": "Họ đang ở đâu đó giữa vùng Texas, vẫn cò"
  },
  {
    "p": 0,
    "s": 3,
    "start": 18.64,
    "end": 22.84,
    "text": "Texas rộng lớn chẳng khác gì một quốc gi"
  },
  {
    "p": 0,
    "s": 4,
    "start": 22.84,
    "end": 25.92,
    "text": "PJ nhìn Sophie, đường nét gương mặt xinh"
  },
  {
    "p": 0,
    "s": 5,
    "start": 25.92,
    "end": 28.72,
    "text": "Kiểu tóc mới rất hợp với cô, ông nghĩ th"
  },
  {
    "p": 0,
    "s": 6,
    "start": 28.72,
    "end": 33.96,
    "text": "“Thật tuyệt vời,” ông nói với con."
  },
  {
    "p": 0,
    "s": 7,
    "start": 33.96,
    "end": 35.96,
    "text": "“Thật đáng kinh ngạc khi con tìm ra được"
  },
  {
    "p": 0,
    "s": 8,
    "start": 35.96,
    "end": 37.8,
    "text": "Bố rất tự hào về con.”"
  },
  {
    "p": 1,
    "s": 0,
    "start": 37.8,
    "end": 38.72,
    "text": "“Chúng ta cùng làm mà, bố."
  },
  {
    "p": 1,
    "s": 1,
    "start": 38.72,
    "end": 44.96,
    "text": "Ý kiến trả tiền cho Zander và mấy đứa bạ"
  },
  {
    "p": 2,
    "s": 0,
    "start": 44.96,
    "end": 46.0,
    "text": "“Cùng hợp tác thật tốt biết bao,” PJ đồn"
  },
  {
    "p": 3,
    "s": 0,
    "start": 46.0,
    "end": 46.64,
    "text": "Sophie thở dài."
  },
  {
    "p": 3,
    "s": 1,
    "start": 46.64,
    "end": 51.96,
    "text": "Cô vẫn đang giận bố, nhưng cô không thể "
  },
  {
    "p": 3,
    "s": 2,
    "start": 51.96,
    "end": 58.0,
    "text": "Cô sẽ chẳng bao giờ tự mình tìm thấy bọn"
  },
  {
    "p": 3,
    "s": 3,
    "start": 58.0,
    "end": 61.56,
    "text": "Bố con là một người đàn ông tốt, mẹ cô t"
  },
  {
    "p": 3,
    "s": 4,
    "start": 61.56,
    "end": 68.72,
    "text": "Mặc dù thực tế bố cô chẳng bao giờ mặc v"
  },
  {
    "p": 3,
    "s": 5,
    "start": 68.72,
    "end": 79.56,
    "text": "Bố rất thích kể cho mọi người nghe về lo"
  },
  {
    "p": 3,
    "s": 6,
    "start": 79.56,
    "end": 83.32,
    "text": "Sophie thừa biết bố không phải là người "
  },
  {
    "p": 3,
    "s": 7,
    "start": 83.32,
    "end": 89.76,
    "text": "Cô biết ông thương cô."
  },
  {
    "p": 3,
    "s": 8,
    "start": 89.76,
    "end": 90.8,
    "text": "Cô biết ông muốn cô thương lại mình."
  },
  {
    "p": 3,
    "s": 9,
    "start": 90.8,
    "end": 96.4,
    "text": "Nhưng bố cũng đã làm cô tổn thương, hết "
  },
  {
    "p": 3,
    "s": 10,
    "start": 96.4,
    "end": 103.16,
    "text": "Đã bao nhiêu lần cô phải bước vào ngôi n"
  },
  {
    "p": 3,
    "s": 11,
    "start": 103.16,
    "end": 110.4,
    "text": "“Bố à,” cô nói."
  },
  {
    "p": 3,
    "s": 12,
    "start": 110.4,
    "end": 116.64,
    "text": "“Con không thể tiếp tục thế này được nữa"
  },
  {
    "p": 4,
    "s": 0,
    "start": 116.64,
    "end": 118.24,
    "text": "“Không thể tiếp tục cái gì cơ?”"
  },
  {
    "p": 5,
    "s": 0,
    "start": 118.24,
    "end": 120.04,
    "text": "“Lái xe khắp thị trấn để tìm bố sau mỗi "
  },
  {
    "p": 5,
    "s": 1,
    "start": 120.04,
    "end": 121.84,
    "text": "Bước chân vào nhà rồi nơm nớp chờ đợi xe"
  },
  {
    "p": 6,
    "s": 0,
    "start": 121.84,
    "end": 123.64,
    "text": "“Sophie, bố chưa bao giờ bắt con phải là"
  },
  {
    "p": 6,
    "s": 1,
    "start": 123.64,
    "end": 125.48,
    "text": "Bố không cần con phải chăm sóc mình nữa."
  },
  {
    "p": 6,
    "s": 2,
    "start": 125.48,
    "end": 126.56,
    "text": "Đó không phải việc của con."
  },
  {
    "p": 6,
    "s": 3,
    "start": 126.56,
    "end": 127.96,
    "text": "Chưa bao giờ là thế cả."
  },
  {
    "p": 6,
    "s": 4,
    "start": 127.96,
    "end": 130.52,
    "text": "Nếu bố nằm thoi thóp bên lề đường, cứ vi"
  },
  {
    "p": 7,
    "s": 0,
    "start": 130.52,
    "end": 134.24,
    "text": "“Con không làm thế vì bố, thưa bố."
  },
  {
    "p": 7,
    "s": 1,
    "start": 134.24,
    "end": 136.0,
    "text": "Con làm vì mẹ."
  },
  {
    "p": 7,
    "s": 2,
    "start": 136.0,
    "end": 138.4,
    "text": "Con đang chăm sóc mẹ, chứ không phải bố."
  },
  {
    "p": 7,
    "s": 3,
    "start": 138.4,
    "end": 140.8,
    "text": "Để mẹ không phải là người phải tận mắt n"
  },
  {
    "p": 8,
    "s": 0,
    "start": 140.8,
    "end": 146.24,
    "text": "“Ôi, Sophie...”"
  },
  {
    "p": 9,
    "s": 0,
    "start": 146.24,
    "end": 150.4,
    "text": "“Một khi con tìm thấy xác bố, con đã tập"
  },
  {
    "p": 9,
    "s": 1,
    "start": 150.4,
    "end": 153.2,
    "text": "Con sẽ vạch mí mắt bố ra, nhìn thẳng vào"
  },
  {
    "p": 9,
    "s": 2,
    "start": 153.2,
    "end": 155.56,
    "text": "Nhưng còn mẹ..."
  },
  {
    "p": 9,
    "s": 3,
    "start": 155.56,
    "end": 158.12,
    "text": "nếu mẹ nhìn thấy bố như thế..."
  },
  {
    "p": 9,
    "s": 4,
    "start": 158.12,
    "end": 162.24,
    "text": "điều đó sẽ giết chết mẹ mất.”"
  },
  {
    "p": 9,
    "s": 5,
    "start": 162.24,
    "end": 163.92,
    "text": "Sophie thốt được câu cuối cùng trong ngh"
  },
  {
    "p": 9,
    "s": 6,
    "start": 163.92,
    "end": 165.56,
    "text": "Con đập nào đó bên trong cô đã vỡ vụn."
  },
  {
    "p": 9,
    "s": 7,
    "start": 165.56,
    "end": 167.96,
    "text": "Cô khóc nức nở và chẳng biết liệu mình c"
  },
  {
    "p": 10,
    "s": 0,
    "start": 167.96,
    "end": 175.08,
    "text": "PJ dịch người sang bên cạnh và ôm lấy So"
  },
  {
    "p": 10,
    "s": 1,
    "start": 175.08,
    "end": 177.8,
    "text": "Ông ôm chặt lấy con khi cô khóc."
  },
  {
    "p": 10,
    "s": 2,
    "start": 177.8,
    "end": 179.44,
    "text": "Đứa con gái đáng thương của ông."
  },
  {
    "p": 10,
    "s": 3,
    "start": 179.44,
    "end": 180.84,
    "text": "Người con duy nhất còn lại trên đời."
  },
  {
    "p": 10,
    "s": 4,
    "start": 180.84,
    "end": 184.76,
    "text": "Ông để cô khóc một lúc lâu."
  },
  {
    "p": 10,
    "s": 5,
    "start": 184.76,
    "end": 186.64,
    "text": "“Bố xin lỗi,” cuối cùng ông cũng cất lời"
  },
  {
    "p": 10,
    "s": 6,
    "start": 186.64,
    "end": 187.96,
    "text": "“Bố thực sự xin lỗi."
  },
  {
    "p": 10,
    "s": 7,
    "start": 187.96,
    "end": 188.36,
    "text": "Bố biết mình ích kỷ."
  },
  {
    "p": 10,
    "s": 8,
    "start": 188.36,
    "end": 197.36,
    "text": "Bố biết bố đã lợi dụng con, mẹ con và cả"
  },
  {
    "p": 11,
    "s": 0,
    "start": 197.36,
    "end": 200.76,
    "text": "“Vâng,” Sophie nói."
  },
  {
    "p": 11,
    "s": 1,
    "start": 200.76,
    "end": 201.16,
    "text": "“Bố đã làm thế đấy.”"
  },
  {
    "p": 11,
    "s": 2,
    "start": 201.16,
    "end": 201.56,
    "text": "Tiếng khóc của cô nhỏ dần."
  },
  {
    "p": 11,
    "s": 3,
    "start": 201.56,
    "end": 206.4,
    "text": "Cô đang kìm nén lại cảm xúc của mình."
  },
  {
    "p": 11,
    "s": 4,
    "start": 206.4,
    "end": 208.36,
    "text": "Hóa ra cô sẽ không khóc mãi mãi đâu."
  },
  {
    "p": 11,
    "s": 5,
    "start": 208.36,
    "end": 211.16,
    "text": "Chẳng ai có thể khóc mãi được cả."
  },
  {
    "p": 11,
    "s": 6,
    "start": 211.16,
    "end": 212.06,
    "text": "Cô gỡ tay ông ra, có chút ngượng ngùng v"
  },
  {
    "p": 12,
    "s": 0,
    "start": 212.06,
    "end": 216.76,
    "text": "“Sophie, bố biết con cứ quẩn quanh ở Pon"
  },
  {
    "p": 12,
    "s": 1,
    "start": 216.76,
    "end": 217.16,
    "text": "Giờ thì bố nhận ra rồi đấy."
  },
  {
    "p": 12,
    "s": 2,
    "start": 217.16,
    "end": 222.84,
    "text": "Con không hề quá phụ thuộc vào mẹ con đâ"
  },
  {
    "p": 12,
    "s": 3,
    "start": 222.84,
    "end": 224.32,
    "text": "Chỉ vì mẹ con cần con giúp một tay lo ch"
  },
  {
    "p": 12,
    "s": 4,
    "start": 224.32,
    "end": 228.52,
    "text": "Sophie, bố nợ con rất nhiều.”"
  },
  {
    "p": 13,
    "s": 0,
    "start": 228.52,
    "end": 230.0,
    "text": "Sophie trầm ngâm suy nghĩ."
  },
  {
    "p": 13,
    "s": 1,
    "start": 230.0,
    "end": 230.74,
    "text": "Nghe bố tự nhận lỗi về mình thật dễ chịu"
  },
  {
    "p": 14,
    "s": 0,
    "start": 230.74,
    "end": 235.88,
    "text": "Nhưng sâu thẳm trong lòng, Sophie cũng t"
  },
  {
    "p": 14,
    "s": 1,
    "start": 235.88,
    "end": 236.53,
    "text": "Cô cảm thấy mình cần mẹ, và mẹ cũng cần "
  },
  {
    "p": 14,
    "s": 2,
    "start": 236.53,
    "end": 244.84,
    "text": "Vào thời điểm ấy, thật khó mà hình dung "
  },
  {
    "p": 14,
    "s": 3,
    "start": 244.84,
    "end": 247.8,
    "text": "Bố cô không phải là người duy nhất bất ổ"
  },
  {
    "p": 14,
    "s": 4,
    "start": 247.8,
    "end": 251.16,
    "text": "Mẹ chưa bao giờ muốn định hình Sophie là"
  },
  {
    "p": 15,
    "s": 0,
    "start": 251.16,
    "end": 254.28,
    "text": "“Làm sao để bố có thể bù đắp cho con đây"
  },
  {
    "p": 15,
    "s": 1,
    "start": 254.28,
    "end": 256.04,
    "text": "bố cô hỏi."
  },
  {
    "p": 16,
    "s": 0,
    "start": 256.04,
    "end": 258.08,
    "text": "Sophie thở dài."
  },
  {
    "p": 16,
    "s": 1,
    "start": 258.08,
    "end": 264.28,
    "text": "Cách đây một tháng, cô hẳn đã bảo ông bỏ"
  },
  {
    "p": 16,
    "s": 2,
    "start": 264.28,
    "end": 268.72,
    "text": "Nhưng ông đang cố gắng làm điều đó; có l"
  },
  {
    "p": 16,
    "s": 3,
    "start": 268.72,
    "end": 271.0,
    "text": "Ông chưa hoàn toàn thành công trong việc"
  },
  {
    "p": 16,
    "s": 4,
    "start": 271.0,
    "end": 272.72,
    "text": "Lần đầu tiên kể từ khi cô còn nhớ được, "
  },
  {
    "p": 16,
    "s": 5,
    "start": 272.72,
    "end": 276.92,
    "text": "“Bố có thể bù đắp cho con bằng cách chăm"
  },
  {
    "p": 16,
    "s": 6,
    "start": 276.92,
    "end": 281.24,
    "text": "Nếu bố thực sự yêu thương và chăm sóc ch"
  },
  {
    "p": 16,
    "s": 7,
    "start": 281.24,
    "end": 287.96,
    "text": "Nếu bố làm được điều đó, nó sẽ chứng min"
  },
  {
    "p": 16,
    "s": 8,
    "start": 287.96,
    "end": 295.96,
    "text": "Đó là một sự lựa chọn, thưa bố; cái chết"
  },
  {
    "p": 16,
    "s": 9,
    "start": 295.96,
    "end": 300.08,
    "text": "Cái chết của Kate không phải là dấu chấm"
  },
  {
    "p": 17,
    "s": 0,
    "start": 300.08,
    "end": 303.16,
    "text": "“Không phải thế thật,” ông đồng tình."
  },
  {
    "p": 17,
    "s": 1,
    "start": 303.16,
    "end": 305.96,
    "text": "Chẳng hiểu sao mọi chuyện lại không phải"
  },
  {
    "p": 18,
    "s": 0,
    "start": 305.96,
    "end": 311.16,
    "text": "“Con sẽ giúp bố chăm sóc lũ trẻ."
  },
  {
    "p": 18,
    "s": 1,
    "start": 311.16,
    "end": 312.36,
    "text": "Con sẽ không để bố phải chịu đựng một mì"
  },
  {
    "p": 18,
    "s": 2,
    "start": 312.36,
    "end": 316.28,
    "text": "Giờ chúng cũng là người nhà của con rồi."
  },
  {
    "p": 19,
    "s": 0,
    "start": 316.28,
    "end": 318.84,
    "text": "“Được rồi."
  },
  {
    "p": 19,
    "s": 1,
    "start": 318.84,
    "end": 322.32,
    "text": "Con sẽ giúp bố."
  },
  {
    "p": 19,
    "s": 2,
    "start": 322.32,
    "end": 324.72,
    "text": "Bố làm được nếu có con giúp.”"
  },
  {
    "p": 20,
    "s": 0,
    "start": 324.72,
    "end": 325.96,
    "text": "“Bố thực sự nghĩ mình có thể cai rượu đư"
  },
  {
    "p": 20,
    "s": 1,
    "start": 325.96,
    "end": 330.04,
    "text": "Bố sẽ phải tuyệt đối không chạm vào một "
  },
  {
    "p": 21,
    "s": 0,
    "start": 330.04,
    "end": 333.52,
    "text": "Đây chính là vấn đề nan giải."
  },
  {
    "p": 21,
    "s": 1,
    "start": 333.52,
    "end": 335.96,
    "text": "PJ không biết liệu mình có giữ được sự t"
  },
  {
    "p": 21,
    "s": 2,
    "start": 335.96,
    "end": 337.6,
    "text": "Ông thực sự không dám chắc."
  },
  {
    "p": 21,
    "s": 3,
    "start": 337.6,
    "end": 339.12,
    "text": "Ông từng thề non hẹn biển là sẽ cai rượu"
  },
  {
    "p": 21,
    "s": 4,
    "start": 339.12,
    "end": 342.64,
    "text": "Lại vướng phải cái câu cửa miệng “chó gi"
  },
  {
    "p": 21,
    "s": 5,
    "start": 342.64,
    "end": 345.52,
    "text": "Nhưng việc giữ cho mình tỉnh táo đâu phả"
  },
  {
    "p": 21,
    "s": 6,
    "start": 345.52,
    "end": 347.56,
    "text": "Nó chỉ đơn giản là việc bạn phải làm mà "
  },
  {
    "p": 21,
    "s": 7,
    "start": 347.56,
    "end": 348.96,
    "text": "“Bố sẽ làm được,” ông đồng ý."
  },
  {
    "p": 21,
    "s": 8,
    "start": 348.96,
    "end": 350.84,
    "text": "“Bố hứa đấy."
  },
  {
    "p": 21,
    "s": 9,
    "start": 350.84,
    "end": 352.6,
    "text": "Lần này bố sẽ làm được.”"
  },
  {
    "p": 22,
    "s": 0,
    "start": 352.6,
    "end": 354.36,
    "text": "“Được rồi,” Sophie nói, và cô cố gắng ti"
  },
  {
    "p": 23,
    "s": 0,
    "start": 354.36,
    "end": 367.44,
    "text": "Sophie và PJ nhìn hai đứa trẻ đang nằm d"
  },
  {
    "p": 23,
    "s": 1,
    "start": 367.44,
    "end": 370.76,
    "text": "Cứ như thể chiếc xe ấy an toàn chỉ vì nó"
  },
  {
    "p": 24,
    "s": 0,
    "start": 370.76,
    "end": 377.0,
    "text": "“Bố nghĩ tụi nhỏ sẽ ổn chứ?”"
  },
  {
