  {
    "p": 36,
    "s": 1,
    "start": 445.92,
    "end": 448.68,
    "text": "“Làm ơn nhanh chân lên!”"
  },
  {
    "p": 36,
    "s": 2,
    "start": 448.68,
    "end": 450.36,
    "text": "cô hét với theo qua cửa sổ."
  },
  {
    "p": 37,
    "s": 0,
    "start": 450.36,
    "end": 453.92,
    "text": "“Hay mình cứ đi mà không cần đợi ông ấy "
  },
  {
    "p": 38,
    "s": 0,
    "start": 453.92,
    "end": 468.04,
    "text": "Sophie đang rất bực bội, giận bố khủng k"
  },
  {
    "p": 38,
    "s": 1,
    "start": 468.04,
    "end": 470.28,
    "text": "Rằng ông chẳng thể nào thay đổi được đâu"
  },
  {
    "p": 38,
    "s": 2,
    "start": 470.28,
    "end": 476.04,
    "text": "Ông sẽ chết từ đời nào rồi trước khi kịp"
  },
  {
    "p": 38,
    "s": 3,
    "start": 476.04,
    "end": 478.44,
    "text": "Cô được giải thoát rồi."
  },
  {
    "p": 38,
    "s": 4,
    "start": 478.44,
    "end": 481.64,
    "text": "Cô không cần phải hy vọng nữa, bởi vì mọ"
  },
  {
    "p": 39,
    "s": 0,
    "start": 481.64,
    "end": 497.04,
    "text": "Sophie đã chuẩn bị tinh thần cho cái chế"
  },
  {
    "p": 39,
    "s": 1,
    "start": 497.04,
    "end": 502.96,
    "text": "Mẹ cô từng bắt đầu gọi bố cô sang ăn sán"
  },
  {
    "p": 39,
    "s": 2,
    "start": 502.96,
    "end": 509.56,
    "text": "Nếu bố cô không ló mặt ra ăn sáng, Fred "
  },
  {
    "p": 39,
    "s": 3,
    "start": 509.56,
    "end": 519.92,
    "text": "Nếu Fred bận đi làm, hoặc bận đi ngắm ch"
  },
  {
    "p": 40,
    "s": 0,
    "start": 519.92,
    "end": 525.64,
    "text": "Sophie thường sẽ tìm thấy bố mình đang n"
  },
  {
    "p": 40,
    "s": 1,
    "start": 525.64,
    "end": 532.68,
    "text": "Nếu ông không ở đó, cô sẽ tìm thấy ông ở"
  },
  {
    "p": 40,
    "s": 2,
    "start": 532.68,
    "end": 536.28,
    "text": "Hoặc đôi khi cô sẽ thấy ông nằm ngửa gần"
  },
  {
    "p": 40,
    "s": 3,
    "start": 536.28,
    "end": 548.68,
    "text": "Cô lúc nào cũng đinh ninh sẽ tìm thấy ôn"
  },
  {
    "p": 40,
    "s": 4,
    "start": 548.68,
    "end": 553.4,
    "text": "Và ông hoàn toàn xứng đáng nhận lấy kết "
  },
  {
    "p": 40,
    "s": 5,
    "start": 553.4,
    "end": 556.0,
    "text": "Đó là lỗi của chính ông."
  },
  {
    "p": 40,
    "s": 6,
    "start": 556.0,
    "end": 560.28,
    "text": "Đó là những gì cô từng nghĩ sẽ xảy ra kh"
  },
  {
    "p": 41,
    "s": 0,
    "start": 560.28,
    "end": 566.68,
    "text": "Nhưng giờ đây PJ lại bước ra từ Nhà nghỉ"
  },
  {
    "p": 41,
    "s": 1,
    "start": 566.68,
    "end": 569.88,
    "text": "“Chúng ta gặp rắc rối rồi,” ông bảo."
  },
  {
    "p": 42,
    "s": 0,
    "start": 569.88,
    "end": 574.67,
    "text": "“Gì nữa đây hả bố?”"
  },
  {
    "p": 42,
    "s": 1,
    "start": 574.67,
    "end": 575.07,
    "text": "Sophie hỏi."
  },
  {
    "p": 43,
    "s": 0,
    "start": 575.07,
