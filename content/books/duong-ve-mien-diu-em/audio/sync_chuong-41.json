  {
    "p": 33,
    "s": 0,
    "start": 362.88,
    "end": 365.0,
    "text": "“Không đâu bố."
  },
  {
    "p": 33,
    "s": 1,
    "start": 365.0,
    "end": 366.32,
    "text": "Con chẳng thấy có bữa sáng nào ở sảnh cả"
  },
  {
    "p": 33,
    "s": 2,
    "start": 366.32,
    "end": 367.28,
    "text": "Nào mấy đứa, lên xe thôi."
  },
  {
    "p": 33,
    "s": 3,
    "start": 367.28,
    "end": 370.96,
    "text": "Đến giờ đi rồi.”"
  },
  {
    "p": 34,
    "s": 0,
    "start": 370.96,
    "end": 373.72,
    "text": "Nhà nghỉ The Golden Cherry hóa ra cũng c"
  },
  {
    "p": 34,
    "s": 1,
    "start": 373.72,
    "end": 376.04,
    "text": "Chắc PJ nên học cách hạ thấp kỳ vọng xuố"
  },
  {
    "p": 34,
    "s": 2,
    "start": 376.04,
    "end": 379.76,
    "text": "Người ta gọi một gã có hai mươi ngàn đô "
  },
  {
    "p": 34,
    "s": 3,
    "start": 379.76,
    "end": 382.96,
    "text": "Nghe cứ như một trò đùa nhạt nhẽo."
  },
  {
    "p": 34,
    "s": 4,
    "start": 382.96,
    "end": 385.92,
    "text": "Ông lên xe, ngồi vào ghế phụ, dịch chuyể"
  },
  {
    "p": 34,
    "s": 5,
    "start": 385.92,
    "end": 394.72,
    "text": "Hôm qua họ đã có một cuộc trò chuyện rất"
  },
  {
    "p": 34,
    "s": 6,
    "start": 394.72,
    "end": 402.92,
    "text": "PJ nên nhẹ nhàng góp ý rằng The Golden C"
  },
  {
    "p": 34,
    "s": 7,
    "start": 402.92,
    "end": 405.8,
    "text": "Con người ta thường dễ tính hơn khi bụng"
  },
  {
    "p": 34,
    "s": 8,
    "start": 405.8,
    "end": 412.28,
    "text": "Gregor từng phàn nàn về những bình luận "
  },
  {
    "p": 34,
    "s": 9,
    "start": 412.28,
    "end": 416.84,
    "text": "Rằng nhà nghỉ tệ hại dã man; rằng mọi th"
  },
  {
    "p": 34,
    "s": 10,
    "start": 416.84,
    "end": 420.32,
    "text": "Ngay lúc này, cái máy sưởi hồ bơi đang b"
  },
  {
    "p": 34,
    "s": 11,
    "start": 420.32,
    "end": 423.2,
    "text": "Thỉnh thoảng mọi thứ cứ hỏng vặt thôi!"
  },
  {
    "p": 34,
    "s": 12,
    "start": 423.2,
    "end": 432.08,
    "text": "Gregor rất muốn biết liệu có tên khốn nà"
  },
  {
    "p": 34,
    "s": 13,
    "start": 432.08,
    "end": 437.08,
    "text": "Anh ta rất muốn thấy bọn họ thử xem sao."
  },
  {
    "p": 35,
    "s": 0,
    "start": 437.08,
    "end": 438.88,
    "text": "“Bố vào trong chốc lát,” PJ nói với Soph"
  },
  {
    "p": 35,
    "s": 1,
    "start": 438.88,
    "end": 441.08,
    "text": "“Vào chào tạm biệt người bạn Gregor một "
