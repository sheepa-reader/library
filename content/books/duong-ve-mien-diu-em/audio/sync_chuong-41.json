    "text": "Bố sẽ không quá bận tâm đến quá khứ nữa."
  },
  {
    "p": 29,
    "s": 0,
    "start": 344.72,
    "end": 345.44,
    "text": "“Tốt.”"
  },
  {
    "p": 30,
    "s": 0,
    "start": 345.44,
    "end": 349.88,
    "text": "“Nhân chuyện hiện tại, Gregor có làm bữa"
  },
  {
    "p": 30,
    "s": 1,
    "start": 349.88,
    "end": 352.28,
    "text": "Tất cả chúng ta đều cần ăn sáng.”"
  },
  {
    "p": 31,
    "s": 0,
    "start": 352.28,
    "end": 356.24,
    "text": "“Không ạ."
  },
  {
    "p": 31,
    "s": 1,
    "start": 356.24,
    "end": 357.16,
    "text": "Mình sẽ ghé mua gì đó dọc đường.”"
  },
  {
    "p": 32,
    "s": 0,
    "start": 357.16,
    "end": 358.72,
    "text": "“Thật á?"
