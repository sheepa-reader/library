    "p": 50,
    "s": 2,
    "start": 704.21,
    "end": 704.79,
    "text": "Vẫn chưa quá muộn đâu.”"
  },
  {
    "p": 51,
    "s": 0,
    "start": 704.79,
    "end": 707.84,
    "text": "“Và điều tồi tệ nhất thì đã xảy ra rồi,”"
  },
