    "start": 763.11,
    "end": 768.41,
    "text": "Bà ngoại của họ từng bị bỏng độ ba gần n"
  },
  {
    "p": 57,
    "s": 2,
    "start": 768.41,
    "end": 769.49,
    "text": "Bà bị mất một phần mũi."
