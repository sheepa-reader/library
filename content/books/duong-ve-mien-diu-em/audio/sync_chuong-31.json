    "text": "Cậu ta đến để nộp tiền tại ngoại cho PJ."
  },
  {
    "p": 31,
    "s": 0,
    "start": 484.14,
    "end": 486.01,
    "text": "Có một giọng nói khác đi cùng cậu ta, gi"
  },
  {
    "p": 31,
    "s": 1,
    "start": 486.01,
    "end": 494.09,
    "text": "Michelle và Gene đã gặp nhau khi cảnh sá"
  },
  {
    "p": 31,
    "s": 2,
    "start": 494.09,
    "end": 504.51,
    "text": "Gene đồng ý, Pauly Halliday vốn không ph"
  },
  {
    "p": 31,
    "s": 3,
    "start": 504.51,
    "end": 510.63,
    "text": "Vào thời điểm họ đến đồn cảnh sát, Gene "
  },
  {
    "p": 31,
    "s": 4,
    "start": 510.63,
    "end": 513.36,
    "text": "Cô vừa xinh đẹp lại vừa tốt bụng."
  },
  {
    "p": 32,
    "s": 0,
    "start": 513.36,
    "end": 520.09,
    "text": "Sau khi Gene nộp tiền tại ngoại, viên cả"
  },
  {
    "p": 33,
    "s": 0,
    "start": 520.09,
    "end": 522.56,
    "text": "“Này nhóc,” người đàn ông lớn tuổi nói."
  },
  {
    "p": 33,
    "s": 1,
    "start": 522.56,
    "end": 526.93,
    "text": "“Thế còn giao kèo của chúng ta thì sao?”"
  },
  {
    "p": 34,
    "s": 0,
    "start": 526.93,
    "end": 528.73,
    "text": "PJ lắc đầu."
  },
  {
    "p": 34,
    "s": 1,
    "start": 528.73,
    "end": 530.11,
    "text": "“Tôi không làm thế được đâu, thưa ông.”"
  },
  {
    "p": 35,
    "s": 0,
    "start": 530.11,
    "end": 533.41,
    "text": "Người đàn ông gầm gừ, nghiến răng ken ké"
  },
  {
    "p": 35,
    "s": 1,
    "start": 533.41,
    "end": 533.93,
    "text": "“Cậu chỉ là một thằng nhóc."
