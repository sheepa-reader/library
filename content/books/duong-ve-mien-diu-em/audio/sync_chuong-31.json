    "s": 1,
    "start": 601.75,
    "end": 607.95,
    "text": "Cô để quên chiếc ví của mình trên chiếc "
  },
  {
    "p": 42,
    "s": 0,
    "start": 607.95,
    "end": 618.92,
    "text": "“Tội nghiệp người đàn ông trong buồng gi"
