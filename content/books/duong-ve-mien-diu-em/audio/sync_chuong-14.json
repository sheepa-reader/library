    "p": 25,
    "s": 1,
    "start": 428.64,
    "end": 430.8,
    "text": "“Thì em có thèm nghe lời chị đâu.”"
  },
  {
    "p": 26,
    "s": 0,
    "start": 430.8,
    "end": 434.03,
    "text": "“Vì chị có phải sếp đâu.”"
  },
  {
    "p": 27,
    "s": 0,
    "start": 434.03,
    "end": 436.43,
    "text": "“Lẽ ra em không nên kể cho y tá nghe chu"
  },
  {
    "p": 27,
    "s": 1,
    "start": 436.43,
    "end": 438.13,
    "text": "Chị đã bảo em đừng nói cơ mà."
  },
  {
    "p": 27,
    "s": 2,
    "start": 438.13,
    "end": 440.14,
    "text": "Mẹ bảo chị thậm chí không được kể cho em"
  },
  {
    "p": 27,
    "s": 3,
    "start": 440.14,
    "end": 441.88,
    "text": "Mẹ bảo em sẽ chẳng bao giờ hiểu được vì "
  },
  {
    "p": 28,
    "s": 0,
    "start": 441.88,
    "end": 444.64,
    "text": "Chú mèo nhảy khỏi tay Luna và tiến lại n"
  },
  {
    "p": 28,
    "s": 1,
    "start": 444.64,
    "end": 449.84,
    "text": "Một giọt nước mắt của Ollie rơi trúng đầ"
  },
  {
    "p": 28,
    "s": 2,
    "start": 449.84,
    "end": 451.24,
    "text": "“Được rồi,” Ollie nói."
  },
  {
    "p": 28,
    "s": 3,
    "start": 451.24,
    "end": 452.68,
    "text": "“Thôi được."
  },
  {
    "p": 28,
    "s": 4,
    "start": 452.68,
    "end": 454.22,
    "text": "Em xin lỗi.”"
  },
  {
    "p": 29,
    "s": 0,
    "start": 454.22,
    "end": 456.27,
    "text": "Luna hỏi dồn: “Em xin lỗi vì điều gì?”"
  },
  {
    "p": 29,
    "s": 1,
