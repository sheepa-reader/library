  {
    "p": 19,
    "s": 7,
    "start": 399.92,
    "end": 405.46,
    "text": "Loài người luôn có cách làm Luna thất vọ"
  },
  {
    "p": 19,
    "s": 8,
    "start": 405.46,
    "end": 411.11,
    "text": "“Chị tìm được một con mèo rồi đây,” Luna"
  },
  {
    "p": 20,
    "s": 0,
    "start": 411.11,
    "end": 413.42,
    "text": "“Chị tìm thấy nó ở đâu thế?”"
  },
  {
    "p": 21,
    "s": 0,
    "start": 413.42,
    "end": 414.57,
    "text": "“Trong bồn tắm của ông PJ."
  },
  {
    "p": 21,
    "s": 1,
    "start": 414.57,
    "end": 416.43,
    "text": "Nó chạy theo chị ra cửa sổ lúc chị đang "
  },
  {
    "p": 22,
    "s": 0,
    "start": 416.43,
    "end": 418.95,
    "text": "“Chị thực sự đang bỏ trốn á?”"
  },
  {
    "p": 23,
    "s": 0,
    "start": 418.95,
    "end": 421.25,
    "text": "“Ừ.”"
  },
  {
    "p": 24,
    "s": 0,
    "start": 421.25,
    "end": 423.35,
    "text": "Đôi mắt Ollie ngấn lệ."
  },
  {
