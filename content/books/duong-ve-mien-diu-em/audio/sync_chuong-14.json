  {
    "p": 13,
    "s": 4,
    "start": 337.46,
    "end": 345.14,
    "text": "Dù vậy, sàn nhà giờ đây đã sạch bóng, và"
  },
  {
    "p": 13,
    "s": 5,
    "start": 345.14,
    "end": 355.09,
    "text": "Ngay bên cạnh cô bé là chiếc túi xách củ"
  },
  {
    "p": 13,
    "s": 6,
    "start": 355.09,
    "end": 357.02,
    "text": "“Chào em, Ollie,” cô bé nói."
