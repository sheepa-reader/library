  {
    "p": 11,
    "s": 6,
    "start": 251.64,
    "end": 258.09,
    "text": "Ông để lại một lời nhắn thoại dài dòng, "
  },
  {
    "p": 11,
    "s": 7,
    "start": 258.09,
    "end": 272.24,
