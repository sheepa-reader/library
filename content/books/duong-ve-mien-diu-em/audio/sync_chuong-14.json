    "s": 4,
    "start": 451.56,
    "end": 454.36,
    "text": "Em xin lỗi.”"
  },
  {
    "p": 29,
    "s": 0,
    "start": 454.36,
    "end": 456.76,
    "text": "Luna hỏi dồn: “Em xin lỗi vì điều gì?”"
  },
  {
    "p": 29,
    "s": 1,
    "start": 456.76,
    "end": 458.24,
    "text": "Cô bé đang thử thách cậu em."
  },
  {
    "p": 30,
    "s": 0,
    "start": 458.24,
    "end": 459.96,
    "text": "“Vì làm con trai."
  },
  {
    "p": 30,
    "s": 1,
    "start": 459.96,
    "end": 462.72,
    "text": "Và vì đã không nghe lời chị."
  },
  {
    "p": 30,
    "s": 2,
    "start": 462.72,
    "end": 464.32,
    "text": "Từ giờ em sẽ nghe lời chị.”"
  },
  {
    "p": 31,
    "s": 0,
    "start": 464.32,
    "end": 465.12,
    "text": "“Lúc nào cũng vậy chứ?”"
  },
  {
    "p": 32,
    "s": 0,
    "start": 465.12,
    "end": 468.64,
    "text": "“Vâng."
  },
  {
    "p": 32,
    "s": 1,
    "start": 468.64,
    "end": 470.08,
    "text": "Nhưng chị không được bỏ đi mà không có e"
  },
  {
    "p": 33,
    "s": 0,
    "start": 470.08,
    "end": 472.76,
    "text": "“Nhất trí,” cô bé nói."
  },
  {
    "p": 33,
    "s": 1,
    "start": 472.76,
    "end": 475.44,
    "text": "“Chị sẽ không bao giờ bỏ đi mà không có "
  },
  {
    "p": 34,
    "s": 0,
    "start": 475.44,
    "end": 477.64,
    "text": "“Tốt.”"
  },
  {
    "p": 34,
    "s": 1,
    "start": 477.64,
    "end": 482.12,
    "text": "Cậu bé lau mắt."
  },
  {
    "p": 34,
    "s": 2,
    "start": 482.12,
    "end": 483.76,
    "text": "“Chị có về nhà ông PJ nữa không?"
  },
  {
    "p": 34,
    "s": 3,
    "start": 483.76,
    "end": 486.04,
    "text": "Ông ấy không tệ đâu Luna, ông ấy không h"
  },
  {
    "p": 34,
    "s": 4,
    "start": 486.04,
    "end": 488.36,
    "text": "Ông ấy mua cho chúng ta một cái bạt nhún"
