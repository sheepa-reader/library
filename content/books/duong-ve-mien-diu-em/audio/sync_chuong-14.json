  {
    "p": 34,
    "s": 5,
    "start": 488.36,
    "end": 490.0,
    "text": "Cả giường tầng nữa chứ."
  },
  {
    "p": 34,
    "s": 6,
    "start": 490.0,
    "end": 491.4,
    "text": "Hàng mới tinh luôn."
  },
  {
    "p": 34,
    "s": 7,
    "start": 491.4,
    "end": 493.56,
    "text": "Mấy tấm nệm vẫn còn bọc nilon."
  },
  {
    "p": 34,
    "s": 8,
    "start": 493.56,
    "end": 494.96,
    "text": "Không có rệp đâu.”"
  },
  {
    "p": 34,
    "s": 9,
    "start": 494.96,
    "end": 496.96,
    "text": "Hồi ở nhà nhận nuôi bên Springfield từng"
  },
  {
    "p": 34,
    "s": 10,
    "start": 496.96,
    "end": 498.32,
    "text": "“Và ông ấy bảo ông ấy thương chúng ta,” "
  },
  {
    "p": 34,
    "s": 11,
    "start": 498.32,
    "end": 500.48,
    "text": "“Ông ấy bảo ông ấy đã thương tụi mình rồ"
  },
  {
    "p": 35,
    "s": 0,
    "start": 500.48,
    "end": 504.76,
    "text": "“Chắc tối nay chị sẽ ở lại đó,” Luna đàn"
  },
  {
    "p": 35,
    "s": 1,
    "start": 504.76,
    "end": 510.88,
    "text": "“Chị không thể ở lại đây được,” cô bé nó"
