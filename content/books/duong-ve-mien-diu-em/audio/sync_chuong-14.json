  {
    "p": 14,
    "s": 0,
    "start": 357.02,
    "end": 358.98,
    "text": "“Luna, chị làm chúng em sợ muốn chết.”"
  },
  {
    "p": 15,
    "s": 0,
    "start": 358.98,
    "end": 361.14,
    "text": "“Chúng em là ai?”"
  },
  {
    "p": 16,
    "s": 0,
    "start": 361.14,
    "end": 361.91,
    "text": "“Là em với ông PJ chứ ai.”"
  },
  {
    "p": 17,
    "s": 0,
    "start": 361.91,
    "end": 364.41,
    "text": "“Còn cô Belinda thì sao?”"
  },
  {
    "p": 18,
    "s": 0,
    "start": 364.41,
    "end": 367.13,
    "text": "“Cô Belinda đi rồi.”"
  },
  {
    "p": 19,
    "s": 0,
    "start": 367.13,
    "end": 369.9,
    "text": "“Ồ,” Luna nói."
  },
  {
    "p": 19,
    "s": 1,
    "start": 369.9,
    "end": 375.93,
    "text": "“Tốt.”"
  },
  {
    "p": 19,
    "s": 2,
    "start": 375.93,
    "end": 378.25,
    "text": "Cô bé thấy nhẹ nhõm vì cô Belinda đã đi,"
  },
  {
    "p": 19,
    "s": 3,
    "start": 378.25,
    "end": 381.48,
    "text": "Cô ấy lại là một người lớn khác không bi"
  },
  {
    "p": 19,
    "s": 4,
    "start": 381.48,
    "end": 383.96,
    "text": "Luna cũng thấy nhẹ nhõm vì Ollie đã tìm "
  },
  {
    "p": 19,
    "s": 5,
    "start": 383.96,
    "end": 389.0,
    "text": "Ban đầu Luna định đến bến xe buýt, nhưng"
  },
  {
    "p": 19,
    "s": 6,
    "start": 389.0,
    "end": 399.92,
    "text": "Cô bé từng hy vọng sẽ tìm được ít tiền t"
