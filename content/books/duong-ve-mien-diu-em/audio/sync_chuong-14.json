  {
    "p": 12,
    "s": 3,
    "start": 304.4,
    "end": 310.19,
    "text": "Lũ chim xích lại gần nhau hơn trên cành "
  },
  {
    "p": 13,
    "s": 0,
    "start": 310.19,
    "end": 318.75,
    "text": "Ollie tìm thấy chị mình đang ngồi bệt tr"
