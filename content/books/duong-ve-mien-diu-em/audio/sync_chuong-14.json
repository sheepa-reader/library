  {
    "p": 8,
    "s": 6,
    "start": 138.0,
    "end": 141.08,
    "text": "“Luna!”"
  },
  {
    "p": 8,
    "s": 7,
    "start": 141.08,
    "end": 142.15,
    "text": "ông hét lên."
