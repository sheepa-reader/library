  {
    "p": 9,
    "s": 5,
    "start": 165.41,
    "end": 169.87,
    "text": "Tôi đã nuôi nấng con cái trưởng thành rồ"
  },
  {
    "p": 9,
    "s": 6,
    "start": 169.87,
    "end": 184.63,
    "text": "Tôi đã đánh mất một người con và làm hỏn"
  },
  {
    "p": 10,
    "s": 0,
    "start": 184.63,
    "end": 187.41,
    "text": "Nhưng khi PJ mở tập hồ sơ ra, có một bức"
