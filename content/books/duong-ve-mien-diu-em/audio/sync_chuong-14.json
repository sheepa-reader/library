  {
    "p": 35,
    "s": 5,
    "start": 529.56,
    "end": 543.2,
    "text": "Đó là một nơi đáng sợ và hỗn độn, nơi mà"
  },
  {
    "p": 36,
    "s": 0,
    "start": 543.2,
    "end": 546.36,
    "text": "“Không,” Ollie đồng tình và cũng nhìn qu"
  },
  {
    "p": 36,
    "s": 1,
    "start": 546.36,
    "end": 549.44,
    "text": "“Em chẳng bao giờ muốn quay lại đây nữa."
  },
  {
    "p": 37,
    "s": 0,
    "start": 549.44,
    "end": 551.56,
    "text": "“Hay chị em mình đốt quách nó đi nhỉ?”"
  },
  {
    "p": 37,
    "s": 1,
    "start": 551.56,
    "end": 559.72,
    "text": "Luna đề nghị, bởi cô bé đang mang theo c"
  },
  {
    "p": 37,
    "s": 2,
    "start": 559.72,
    "end": 568.0,
    "text": "Luna biết ông ngoại từng đốt nhà một lần"
  },
  {
    "p": 37,
    "s": 3,
    "start": 568.0,
    "end": 572.84,
    "text": "Ông từng cố châm lửa đốt căn nhà có một "
  },
  {
    "p": 37,
    "s": 4,
    "start": 572.84,
    "end": 578.32,
    "text": "Ông ngoại có rất nhiều câu chuyện đáng s"
  },
  {
    "p": 37,
    "s": 5,
    "start": 578.32,
    "end": 579.96,
    "text": "“Ông PJ thực sự nói ông ấy thương tụi mì"
  },
  {
    "p": 37,
    "s": 6,
    "start": 579.96,
    "end": 583.16,
    "text": "Luna hỏi lại."
  },
  {
    "p": 38,
    "s": 0,
    "start": 583.16,
    "end": 585.96,
    "text": "“Vâng,” Ollie lại nói dối."
  },
  {
    "p": 38,
    "s": 1,
    "start": 585.96,
    "end": 589.08,
    "text": "“Ông ấy nói thế thật mà.”"
  },
  {
    "p": 39,
    "s": 0,
    "start": 589.08,
    "end": 590.4,
    "text": "Luna thừa biết Ollie đang nói dối, nhưng"
  },
  {
    "p": 40,
    "s": 0,
    "start": 590.4,
    "end": 594.36,
    "text": "“Và nếu ông ấy không thương, chị em mình"
  },
  {
    "p": 40,
    "s": 1,
    "start": 594.36,
    "end": 597.56,
    "text": "Chị em mình sẽ đi tìm bố của chị,” Ollie"
  },
  {
    "p": 41,
    "s": 0,
    "start": 597.56,
    "end": 600.56,
    "text": "“Được,” Luna đáp."
  },
  {
    "p": 41,
    "s": 1,
    "start": 600.56,
    "end": 604.04,
    "text": "Cô bé cũng đang rất cần được nghe câu nó"
  },
  {
    "p": 42,
    "s": 0,
    "start": 604.04,
    "end": 619.16,
    "text": "Lũ kền kền đậu trên cây thích ngoài ngôi"
  },
  {
    "p": 42,
    "s": 1,
    "start": 619.16,
    "end": 622.4,
    "text": "Lũ chim dõi theo bóng hai đứa trẻ đang đ"
  },
  {
    "p": 42,
    "s": 2,
    "start": 622.4,
    "end": 627.08,
    "text": "Luna giữ im lặng, nhưng Ollie hét lớn đá"
  },
  {
    "p": 42,
    "s": 3,
    "start": 627.08,
    "end": 629.04,
    "text": "Bọn cháu tìm thấy mèo của ông PJ rồi ông"
  },
  {
    "p": 42,
    "s": 4,
    "start": 629.04,
    "end": 637.56,
    "text": "Chú mèo vẫn còn sống!”"
  },
  {
    "p": 43,
    "s": 0,
    "start": 637.56,
    "end": 643.92,
    "text": "Còn sống, lũ kền kền đồng thanh xác nhận"
