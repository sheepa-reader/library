  {
    "p": 72,
    "s": 2,
    "start": 1191.2,
    "end": 1193.24,
    "text": "Nhưng cô cũng chẳng đi đến đâu cả."
  },
  {
    "p": 72,
    "s": 3,
    "start": 1193.24,
    "end": 1197.16,
    "text": "Sự trì trệ tuổi trưởng thành, cô từng th"
