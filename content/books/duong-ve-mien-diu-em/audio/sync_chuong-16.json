    "p": 71,
    "s": 0,
    "start": 1173.92,
    "end": 1175.64,
    "text": "“Chính xác."
  },
  {
    "p": 71,
    "s": 1,
    "start": 1175.64,
    "end": 1177.64,
    "text": "Một chiếc bánh rán kiểu Pháp."
