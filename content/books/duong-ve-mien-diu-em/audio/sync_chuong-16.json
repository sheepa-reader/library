    "p": 53,
    "s": 0,
    "start": 934.22,
    "end": 934.92,
    "text": "Sophie liền sập bẫy."
  },
  {
    "p": 53,
    "s": 1,
    "start": 934.92,
    "end": 936.98,
    "text": "“Michelle Cobb là ai?”"
  },
  {
    "p": 54,
    "s": 0,
    "start": 936.98,
    "end": 938.46,
    "text": "“À, cô ấy là mối tình đầu của bố."
