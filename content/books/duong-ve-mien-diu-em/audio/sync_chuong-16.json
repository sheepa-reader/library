  {
    "p": 54,
    "s": 1,
    "start": 938.46,
    "end": 940.2,
    "text": "Người mà bố đã bỏ lỡ."
  },
  {
    "p": 54,
    "s": 2,
    "start": 940.2,
    "end": 942.1,
    "text": "Cô ấy đã lấy người khác khi bố đi lính ở"
  },
  {
    "p": 54,
    "s": 3,
    "start": 942.1,
    "end": 945.34,
    "text": "Và giờ cô ấy cuối cùng cũng độc thân trở"
  },
  {
    "p": 54,
    "s": 4,
    "start": 945.34,
    "end": 949.6,
    "text": "Cô ấy đang sống ở Tucson, bang Arizona, "
  },
  {
    "p": 55,
    "s": 0,
    "start": 949.6,
    "end": 952.86,
    "text": "“Bố vẫn hay gọi điện trò chuyện với Mich"
