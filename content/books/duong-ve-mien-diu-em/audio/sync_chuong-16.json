    "p": 61,
    "s": 2,
    "start": 1013.66,
    "end": 1016.84,
    "text": "Con thất nghiệp rồi, nên con đi được.”"
  },
  {
    "p": 62,
    "s": 0,
    "start": 1016.84,
    "end": 1019.1,
    "text": "“Thế công việc của con bị sao thế?”"
