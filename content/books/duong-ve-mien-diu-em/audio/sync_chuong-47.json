    "p": 24,
    "s": 3,
    "start": 289.76,
    "end": 297.72,
    "text": "“Và bố tôi đã dành trọn phần đời còn lại"
  },
  {
    "p": 24,
    "s": 4,
    "start": 297.72,
    "end": 305.96,
    "text": "Chuyện đó có thể khiến một người đàn ông"
