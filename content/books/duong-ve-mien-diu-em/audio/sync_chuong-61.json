  {
    "p": 62,
    "s": 5,
    "start": 920.36,
    "end": 925.56,
    "text": "Xin mời PJ, hãy đứng lên để mọi người có"
  },
  {
    "p": 62,
    "s": 6,
    "start": 925.56,
    "end": 927.56,
    "text": "Anh ấy đang ngồi tít ở hàng ghế cuối.”"
  },
  {
    "p": 63,
    "s": 0,
    "start": 927.56,
    "end": 933.96,
    "text": "Mọi người nhổm người trên ghế."
  },
  {
    "p": 63,
    "s": 1,
    "start": 933.96,
    "end": 939.16,
    "text": "PJ đứng dậy, mặt đỏ bừng, nhưng cũng vừa"
  },
  {
    "p": 63,
    "s": 2,
    "start": 939.16,
    "end": 943.76,
    "text": "Ông rất vui khi nghe thấy tên mẹ mình đư"
  },
  {
    "p": 63,
    "s": 3,
    "start": 943.76,
    "end": 945.96,
    "text": "Ông phải hỏi người phụ nữ ngồi phía trướ"
  },
  {
    "p": 63,
    "s": 4,
    "start": 945.96,
    "end": 950.84,
    "text": "Bởi vì người phụ nữ đó trông giống hệt m"
  },
  {
    "p": 63,
    "s": 5,
    "start": 950.84,
    "end": 955.56,
    "text": "Người phụ nữ ấy trông thật xinh đẹp, giố"
  },
  {
    "p": 63,
    "s": 6,
    "start": 955.56,
    "end": 962.36,
    "text": "Cách mà PJ thích nhớ về bà."
  },
  {
    "p": 64,
    "s": 0,
    "start": 962.36,
    "end": 965.68,
    "text": "Nhưng khi PJ ngồi xuống lại, người phụ n"
  },
  {
    "p": 64,
    "s": 1,
    "start": 965.68,
    "end": 971.64,
    "text": "Ông không hề thấy bà bước đi; làm sao mà"
  },
  {
    "p": 64,
    "s": 2,
    "start": 971.64,
    "end": 973.24,
    "text": "Bà vừa ngồi ngay trước mặt ông và lũ trẻ"
