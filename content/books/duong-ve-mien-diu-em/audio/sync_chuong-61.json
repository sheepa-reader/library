  {
    "p": 65,
    "s": 2,
    "start": 1021.24,
    "end": 1027.92,
    "text": "Bà thường làm một cây vào mỗi buổi sáng "
  },
  {
    "p": 65,
    "s": 3,
    "start": 1027.92,
    "end": 1044.04,
    "text": "Nó không hoành tráng bằng những cây kẹo "
