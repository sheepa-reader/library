    "text": "Người phụ nữ cầm chiếc túi nhung đựng kẹ"
  },
  {
    "p": 54,
    "s": 1,
    "start": 806.76,
    "end": 808.64,
    "text": "“Cháu có muốn một chiếc kẹo mút không?"
  },
  {
    "p": 54,
    "s": 2,
    "start": 808.64,
    "end": 811.04,
    "text": "Nó có thể giúp cháu bớt nói chuyện đấy.”"
  },
  {
    "p": 55,
    "s": 0,
    "start": 811.04,
    "end": 812.88,
    "text": "“Vâng,” PJ nói, nhìn người phụ nữ cầm kẹ"
  },
  {
    "p": 55,
    "s": 1,
    "start": 812.88,
    "end": 815.72,
    "text": "Và khi ánh mắt hai người chạm nhau, ngay"
  },
  {
    "p": 55,
    "s": 2,
    "start": 815.72,
    "end": 818.04,
    "text": "“Ôi trời,” PJ thốt lên."
  },
  {
    "p": 56,
    "s": 0,
    "start": 818.04,
    "end": 820.48,
    "text": "Người phụ nữ đặt ngón tay đeo găng lên đ"
  },
  {
    "p": 57,
    "s": 0,
    "start": 820.48,
    "end": 824.76,
    "text": "PJ đợi một lát để lấy lại hơi thở, nhưng"
  },
  {
    "p": 57,
    "s": 1,
    "start": 824.76,
    "end": 829.96,
    "text": "Bà đang mặc một chiếc váy chấm bi, kiểu "
  },
  {
    "p": 57,
    "s": 2,
    "start": 829.96,
    "end": 836.6,
    "text": "Ông nhận ra chiếc túi xách bằng nhung tí"
  },
  {
    "p": 57,
    "s": 3,
    "start": 836.6,
    "end": 841.92,
    "text": "“Tôi xin lỗi,” PJ thì thầm."
  },
  {
    "p": 57,
    "s": 4,
    "start": 841.92,
    "end": 843.2,
    "text": "“Bà có phải là..."
  },
  {
    "p": 57,
    "s": 5,
    "start": 843.2,
    "end": 847.92,
    "text": "tôi biết chắc chắn là không phải, nhưng "
  },
  {
    "p": 58,
    "s": 0,
    "start": 847.92,
    "end": 856.8,
    "text": "“Pauly,” người phụ nữ nghiêm nghị nói, g"
  },
  {
    "p": 58,
    "s": 1,
    "start": 856.8,
    "end": 858.0,
    "text": "“Đây là đám tang."
  },
  {
    "p": 58,
    "s": 2,
    "start": 858.0,
    "end": 860.88,
    "text": "Chúng ta phải chú ý và tỏ lòng thành kín"
  },
  {
    "p": 59,
    "s": 0,
    "start": 860.88,
    "end": 862.76,
    "text": "“Vâng, đúng vậy, tất nhiên rồi."
  },
  {
    "p": 59,
    "s": 1,
    "start": 862.76,
    "end": 870.36,
    "text": "Tôi chỉ thắc mắc là..."
  },
  {
    "p": 59,
    "s": 2,
    "start": 870.36,
    "end": 873.4,
    "text": "trông bà y hệt như...”"
  },
  {
    "p": 60,
    "s": 0,
    "start": 873.4,
    "end": 875.88,
    "text": "Người phụ nữ lại đặt ngón tay lên môi để"
