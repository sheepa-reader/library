  {
    "p": 61,
    "s": 1,
    "start": 880.2,
    "end": 885.24,
    "text": "Đứa cháu trai sắp đọc một đoạn trích từ "
  },
  {
    "p": 61,
    "s": 2,
    "start": 885.24,
    "end": 889.56,
    "text": "Đứa cháu trai, cháu của Michelle, chính "
