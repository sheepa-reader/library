  {
    "p": 64,
    "s": 3,
    "start": 973.24,
    "end": 975.16,
    "text": "Thế mà bà đã biến mất."
  },
  {
    "p": 64,
    "s": 4,
    "start": 975.16,
    "end": 977.56,
    "text": "Chắc là ông tưởng tượng ra thôi."
  },
  {
    "p": 64,
    "s": 5,
    "start": 977.56,
    "end": 980.68,
    "text": "Chắc là ông lại đang phát điên rồi."
  },
  {
    "p": 64,
    "s": 6,
    "start": 980.68,
    "end": 983.96,
    "text": "Ông biết đôi khi mình hay nghe thấy nhữn"
  },
  {
    "p": 64,
    "s": 7,
    "start": 983.96,
    "end": 987.92,
    "text": "Chú mèo trò chuyện với mình, ngôi nhà, c"
  },
  {
    "p": 64,
    "s": 8,
    "start": 987.92,
    "end": 991.12,
    "text": "Có lẽ giờ đây ông còn nhìn thấy cả những"
  },
  {
    "p": 64,
    "s": 9,
    "start": 991.12,
    "end": 994.36,
    "text": "Con ma của mẹ ông."
  },
  {
    "p": 64,
    "s": 10,
    "start": 994.36,
    "end": 997.2,
    "text": "Chắc chắn là vì suốt đêm qua ông chẳng t"
  },
  {
    "p": 64,
    "s": 11,
    "start": 997.2,
    "end": 998.96,
    "text": "Cả tuần nay đi đường dài ông cũng ngủ rấ"
  },
  {
    "p": 64,
    "s": 12,
    "start": 998.96,
    "end": 1008.16,
    "text": "Tất cả chỉ là do thiếu ngủ, cai rượu đột"
  },
  {
    "p": 65,
    "s": 0,
    "start": 1008.16,
    "end": 1016.44,
    "text": "Nhưng khi PJ quay đầu lại, Ollie và Luna"
